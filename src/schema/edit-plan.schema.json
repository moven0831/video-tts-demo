{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "width",
            "height",
            "fps",
            "duration"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "const": 1920
            },
            "height": {
              "type": "number",
              "const": 1080
            },
            "fps": {
              "type": "number",
              "const": 30
            }
          },
          "required": [
            "width",
            "height",
            "fps"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "project",
        "title",
        "source",
        "output"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "theme": {
          "default": "dark",
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "accent": {
          "default": "#6E56CF",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "default": "Inter",
          "type": "string"
        },
        "captions": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "burn-in",
              "type": "string",
              "enum": [
                "burn-in",
                "off"
              ]
            },
            "maxCharsPerLine": {
              "default": 42,
              "type": "number",
              "const": 42
            },
            "maxLines": {
              "default": 2,
              "type": "number",
              "const": 2
            }
          },
          "required": [
            "mode",
            "maxCharsPerLine",
            "maxLines"
          ],
          "additionalProperties": false
        },
        "camera": {
          "type": "object",
          "properties": {
            "maxZoom": {
              "default": 2.4,
              "type": "number",
              "minimum": 1,
              "maximum": 3
            },
            "moveSec": {
              "default": 0.7,
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "maxZoom",
            "moveSec"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "theme",
        "accent",
        "font",
        "captions",
        "camera"
      ],
      "additionalProperties": false
    },
    "intro": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "title",
            "chapter",
            "outro"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "maxLength": 90
        },
        "sec": {
          "default": 3,
          "type": "number",
          "minimum": 0
        },
        "narration": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "pauseAfter": {
                "default": 0.35,
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "text",
              "pauseAfter"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "title",
        "sec",
        "narration"
      ],
      "additionalProperties": false
    },
    "outro": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "title",
            "chapter",
            "outro"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "maxLength": 90
        },
        "sec": {
          "default": 3,
          "type": "number",
          "minimum": 0
        },
        "narration": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "pauseAfter": {
                "default": 0.35,
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "text",
              "pauseAfter"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "title",
        "sec",
        "narration"
      ],
      "additionalProperties": false
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "card": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "title",
                  "chapter",
                  "outro"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "subtitle": {
                "type": "string",
                "maxLength": 90
              },
              "sec": {
                "default": 3,
                "type": "number",
                "minimum": 0
              },
              "narration": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "pauseAfter": {
                      "default": 0.35,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "pauseAfter"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "title",
              "sec",
              "narration"
            ],
            "additionalProperties": false
          },
          "scenes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "in": {
                      "type": "number",
                      "minimum": 0
                    },
                    "out": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "in",
                    "out"
                  ],
                  "additionalProperties": false
                },
                "fit": {
                  "default": "freeze",
                  "type": "string",
                  "enum": [
                    "hold",
                    "freeze",
                    "slow",
                    "trim"
                  ]
                },
                "narration": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 600
                      },
                      "at": {
                        "type": "number",
                        "minimum": 0
                      },
                      "pauseAfter": {
                        "default": 0.35,
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "id",
                      "text",
                      "pauseAfter"
                    ],
                    "additionalProperties": false
                  }
                },
                "camera": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0
                      },
                      "box": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "x": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "y": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "w": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "h": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "x",
                              "y",
                              "w",
                              "h"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "t",
                      "box"
                    ],
                    "additionalProperties": false
                  }
                },
                "clicks": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "kind": {
                        "default": "click",
                        "type": "string",
                        "enum": [
                          "click",
                          "double",
                          "drag"
                        ]
                      }
                    },
                    "required": [
                      "t",
                      "x",
                      "y",
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                },
                "callouts": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t0": {
                        "type": "number",
                        "minimum": 0
                      },
                      "t1": {
                        "type": "number",
                        "minimum": 0
                      },
                      "box": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "w": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "h": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "w",
                          "h"
                        ],
                        "additionalProperties": false
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "kind": {
                        "default": "box",
                        "type": "string",
                        "enum": [
                          "box",
                          "arrow",
                          "annotate"
                        ]
                      },
                      "side": {
                        "default": "auto",
                        "type": "string",
                        "enum": [
                          "auto",
                          "top",
                          "bottom",
                          "left",
                          "right"
                        ]
                      }
                    },
                    "required": [
                      "t0",
                      "t1",
                      "box",
                      "label",
                      "kind",
                      "side"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "source",
                "fit",
                "narration",
                "camera",
                "clicks",
                "callouts"
              ],
              "additionalProperties": false
            }
          },
          "transition": {
            "default": {
              "kind": "cut",
              "sec": 0
            },
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cut",
                  "fade-black",
                  "dissolve",
                  "push"
                ]
              },
              "sec": {
                "default": 0.5,
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "sec"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "scenes",
          "transition"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "object",
          "properties": {
            "voiceId": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "voiceId",
            "modelId"
          ],
          "additionalProperties": false
        },
        "music": {
          "type": "object",
          "properties": {
            "file": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[^/\\\\.][^/\\\\]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "prompt": {
              "type": "string",
              "maxLength": 400
            },
            "gainDb": {
              "default": -18,
              "type": "number"
            },
            "duckDb": {
              "default": -12,
              "type": "number"
            }
          },
          "required": [
            "file",
            "gainDb",
            "duckDb"
          ],
          "additionalProperties": false
        },
        "sfx": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scene": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "t": {
                "type": "number",
                "minimum": 0
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sec": {
                "type": "number",
                "minimum": 0,
                "maximum": 30
              }
            },
            "required": [
              "scene",
              "t",
              "prompt",
              "sec"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "voice",
        "music",
        "sfx"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "meta",
    "style",
    "chapters",
    "audio"
  ],
  "additionalProperties": false
}
