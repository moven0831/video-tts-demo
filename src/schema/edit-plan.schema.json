{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source pixels"
            },
            "height": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source pixels"
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration": {
              "type": "number",
              "minimum": 0,
              "description": "seconds of the source recording"
            }
          },
          "required": [
            "width",
            "height",
            "fps",
            "duration"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "const": 1920
            },
            "height": {
              "type": "number",
              "const": 1080
            },
            "fps": {
              "type": "number",
              "const": 30
            }
          },
          "required": [
            "width",
            "height",
            "fps"
          ]
        }
      },
      "required": [
        "project",
        "title",
        "source",
        "output"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "theme": {
          "default": "dark",
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "accent": {
          "default": "#6E56CF",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "default": "Inter",
          "type": "string"
        },
        "captions": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "burn-in",
              "type": "string",
              "enum": [
                "burn-in",
                "off"
              ]
            },
            "maxCharsPerLine": {
              "default": 42,
              "type": "number",
              "const": 42
            },
            "maxLines": {
              "default": 2,
              "type": "number",
              "const": 2
            }
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "maxZoom": {
              "default": 2.4,
              "type": "number",
              "minimum": 1,
              "maximum": 3
            },
            "moveSec": {
              "default": 0.7,
              "type": "number",
              "minimum": 0,
              "description": "seconds a camera move takes, in the output"
            }
          }
        }
      },
      "required": [
        "captions",
        "camera"
      ]
    },
    "intro": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "title",
            "chapter",
            "outro"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "maxLength": 90
        },
        "sec": {
          "default": 3,
          "type": "number",
          "minimum": 0,
          "description": "seconds the card is shown, in the output"
        },
        "narration": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "description": "seconds of the source recording"
              },
              "pauseAfter": {
                "default": 0.35,
                "type": "number",
                "minimum": 0,
                "description": "seconds of silence after the line, in the output"
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "kind",
        "title"
      ]
    },
    "outro": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "title",
            "chapter",
            "outro"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "maxLength": 90
        },
        "sec": {
          "default": 3,
          "type": "number",
          "minimum": 0,
          "description": "seconds the card is shown, in the output"
        },
        "narration": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "at": {
                "type": "number",
                "minimum": 0,
                "description": "seconds of the source recording"
              },
              "pauseAfter": {
                "default": 0.35,
                "type": "number",
                "minimum": 0,
                "description": "seconds of silence after the line, in the output"
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "kind",
        "title"
      ]
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "card": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "title",
                  "chapter",
                  "outro"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "subtitle": {
                "type": "string",
                "maxLength": 90
              },
              "sec": {
                "default": 3,
                "type": "number",
                "minimum": 0,
                "description": "seconds the card is shown, in the output"
              },
              "narration": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0,
                      "description": "seconds of the source recording"
                    },
                    "pauseAfter": {
                      "default": 0.35,
                      "type": "number",
                      "minimum": 0,
                      "description": "seconds of silence after the line, in the output"
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "title"
            ]
          },
          "scenes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "in": {
                      "type": "number",
                      "minimum": 0,
                      "description": "seconds of the source recording"
                    },
                    "out": {
                      "type": "number",
                      "minimum": 0,
                      "description": "seconds of the source recording"
                    }
                  },
                  "required": [
                    "in",
                    "out"
                  ]
                },
                "fit": {
                  "default": "freeze",
                  "type": "string",
                  "enum": [
                    "hold",
                    "freeze",
                    "slow",
                    "trim"
                  ]
                },
                "narration": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 600
                      },
                      "at": {
                        "type": "number",
                        "minimum": 0,
                        "description": "seconds of the source recording"
                      },
                      "pauseAfter": {
                        "default": 0.35,
                        "type": "number",
                        "minimum": 0,
                        "description": "seconds of silence after the line, in the output"
                      }
                    },
                    "required": [
                      "id",
                      "text"
                    ]
                  }
                },
                "camera": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0,
                        "description": "seconds of the source recording"
                      },
                      "box": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "x": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991,
                                "description": "source pixels"
                              },
                              "y": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991,
                                "description": "source pixels"
                              },
                              "w": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991,
                                "description": "source pixels"
                              },
                              "h": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991,
                                "description": "source pixels"
                              }
                            },
                            "required": [
                              "x",
                              "y",
                              "w",
                              "h"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "t",
                      "box"
                    ]
                  }
                },
                "clicks": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0,
                        "description": "seconds of the source recording"
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "source pixels"
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "source pixels"
                      },
                      "kind": {
                        "default": "click",
                        "type": "string",
                        "enum": [
                          "click",
                          "double",
                          "drag"
                        ]
                      }
                    },
                    "required": [
                      "t",
                      "x",
                      "y"
                    ]
                  }
                },
                "callouts": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t0": {
                        "type": "number",
                        "minimum": 0,
                        "description": "seconds of the source recording"
                      },
                      "t1": {
                        "type": "number",
                        "minimum": 0,
                        "description": "seconds of the source recording"
                      },
                      "box": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991,
                            "description": "source pixels"
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991,
                            "description": "source pixels"
                          },
                          "w": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "source pixels"
                          },
                          "h": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "source pixels"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "w",
                          "h"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "kind": {
                        "default": "box",
                        "type": "string",
                        "enum": [
                          "box",
                          "arrow",
                          "annotate"
                        ]
                      },
                      "side": {
                        "default": "auto",
                        "type": "string",
                        "enum": [
                          "auto",
                          "top",
                          "bottom",
                          "left",
                          "right"
                        ]
                      }
                    },
                    "required": [
                      "t0",
                      "t1",
                      "box",
                      "label"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "source",
                "narration"
              ]
            }
          },
          "transition": {
            "default": {
              "kind": "cut",
              "sec": 0
            },
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cut",
                  "fade-black",
                  "dissolve",
                  "push"
                ]
              },
              "sec": {
                "default": 0.5,
                "type": "number",
                "minimum": 0,
                "description": "seconds the transition takes, in the output"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "scenes"
        ]
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "object",
          "properties": {
            "voiceId": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "voiceId",
            "modelId"
          ]
        },
        "music": {
          "type": "object",
          "properties": {
            "file": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[^/\\\\.][^/\\\\]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "prompt": {
              "type": "string",
              "maxLength": 400
            },
            "gainDb": {
              "default": -18,
              "type": "number"
            },
            "duckDb": {
              "default": -12,
              "type": "number",
              "maximum": 0
            }
          }
        },
        "sfx": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scene": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "t": {
                "type": "number",
                "minimum": 0,
                "description": "seconds of the source recording"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sec": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 30,
                "description": "seconds of sound effect"
              }
            },
            "required": [
              "scene",
              "t",
              "prompt",
              "sec"
            ]
          }
        }
      },
      "required": [
        "voice",
        "music"
      ]
    }
  },
  "required": [
    "version",
    "meta",
    "style",
    "chapters",
    "audio"
  ]
}
