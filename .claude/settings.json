{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "allow": [
      "Bash(npm run probe *)",
      "Bash(npm run plan:check *)",
      "Bash(npm run timeline *)",
      "Bash(npm run compose *)",
      "Bash(npm run render *)",
      "Bash(npm run mux *)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:smoke)",
      "Bash(npm run check)"
    ]
  },
  "env": {
    "HYPERFRAMES_NO_UPDATE_CHECK": "1",
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes",
        "ref": "v0.8.183"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true
  }
}
